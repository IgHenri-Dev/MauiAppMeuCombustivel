<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMeuCombustivel.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="comb.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Combustível" />

            <Label Text="Preço do Etanol:" />
            <Entry x:Name="txt_etanol" Placeholder="R$ " Keyboard="Numeric" />

            <Label Text="Preço da Gasolina:" />
            <Entry x:Name="txt_gasolina" Placeholder="R$ " Keyboard="Numeric" />

            <Label Text="Marca do Veículo:" />
            <Entry x:Name="txt_Marca" Placeholder="Marca " Keyboard="Text" />

            <Label Text="Modelo do Veículo:" />
            <Entry x:Name="txt_Modelo" Placeholder="Modelo " Keyboard="Text" />


            <Button Text="Qual compensa mais?" Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
